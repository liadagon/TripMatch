}

### Login for a legacy user without a password - expected 401, not 500
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "legacy-without-password@example.com",
  "password": "ExamplePassword123!"
}

### Upload file
POST {{baseUrl}}/api/file
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=TripMatchBoundary

--TripMatchBoundary
Content-Disposition: form-data; name="file"; filename="sample-photo.jpg"
Content-Type: image/jpeg

< ./sample-photo.jpg
--TripMatchBoundary--

### Record a like for another user - expected 200
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "toUser": "{{otherUserId}}",
  "action": "like"
}

### Repeat the same like - expected 200 and the same swipe record is updated
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "toUser": "{{otherUserId}}",
  "action": "like"
}

### Record a skip for another real user - expected 200
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "toUser": "{{thirdUserId}}",
  "action": "skip"
}

### Change the existing swipe state - expected 200 without a duplicate record
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "toUser": "{{thirdUserId}}",
  "action": "like"
}

### Swipe without a token - expected 401
POST {{baseUrl}}/api/swipes
Content-Type: application/json

{
  "toUser": "{{otherUserId}}",
  "action": "like"
}

### Invalid target ObjectId - expected 400
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "toUser": "not-an-object-id",
  "action": "like"
}

### Well-formed but nonexistent target user - expected 404
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "toUser": "{{nonexistentUserId}}",
  "action": "like"
}

### Swipe on the authenticated user's own profile - expected 400
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "toUser": "{{userId}}",
  "action": "like"
}

### Unsupported swipe action - expected 400
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "toUser": "{{otherUserId}}",
  "action": "superlike"
}

### List swipes - expected one current record per fromUser/toUser pair
GET {{baseUrl}}/api/swipes
Authorization: Bearer {{token}}

### A likes B above - expected isMatch false until B likes A

### B likes A - expected 200, isMatch true, and one Match
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{
  "toUser": "{{userId}}",
  "action": "like"
}

### Get Matches as A - expected B and only Matches containing A
GET {{baseUrl}}/api/matches
Authorization: Bearer {{token}}

### Get Matches as B - expected A and only Matches containing B
GET {{baseUrl}}/api/matches
Authorization: Bearer {{otherToken}}

### Repeat B's reciprocal Like - expected the existing Match, no duplicate
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{
  "toUser": "{{userId}}",
  "action": "like"
}

### Third user skips A while A has liked third user - expected isMatch false
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{thirdToken}}
Content-Type: application/json

{
  "toUser": "{{userId}}",
  "action": "skip"
}

### Get Matches without a token - expected 401
GET {{baseUrl}}/api/matches

### Create/get A-B conversation from their valid Match - expected 200
GET {{baseUrl}}/api/conversations/with/{{otherUserId}}
Authorization: Bearer {{token}}

### Open the same Match again - expected the same conversation ID
GET {{baseUrl}}/api/conversations/with/{{otherUserId}}
Authorization: Bearer {{token}}

### B opens the same Match - expected the same conversation ID
GET {{baseUrl}}/api/conversations/with/{{userId}}
Authorization: Bearer {{otherToken}}

### Attempt conversation without a Match - expected 404
GET {{baseUrl}}/api/conversations/with/{{thirdUserId}}
Authorization: Bearer {{token}}

### List A's conversations - expected only conversations containing A
GET {{baseUrl}}/api/conversations
Authorization: Bearer {{token}}

### List B's conversations - expected only conversations containing B
GET {{baseUrl}}/api/conversations
Authorization: Bearer {{otherToken}}

### List third user's conversations - expected no A-B conversation
GET {{baseUrl}}/api/conversations
Authorization: Bearer {{thirdToken}}

### List conversations without a token - expected 401
GET {{baseUrl}}/api/conversations

### Send a valid message as A - expected 201 and sender derived from token
POST {{baseUrl}}/api/conversations/{{conversationId}}/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Hello from A"
}

### Load persisted messages as A - expected 200
GET {{baseUrl}}/api/conversations/{{conversationId}}/messages
Authorization: Bearer {{token}}

### Load the same persisted messages as B - expected 200
GET {{baseUrl}}/api/conversations/{{conversationId}}/messages
Authorization: Bearer {{otherToken}}

### Send B's persisted reply - expected 201
POST {{baseUrl}}/api/conversations/{{conversationId}}/messages
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{
  "text": "Reply from B"
}

### Whitespace-only message - expected 400
POST {{baseUrl}}/api/conversations/{{conversationId}}/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "   "
}

### Fake sender field - expected 400
POST {{baseUrl}}/api/conversations/{{conversationId}}/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "This must be rejected",
  "sender": "{{thirdUserId}}"
}

