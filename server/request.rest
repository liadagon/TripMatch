@baseUrl = http://127.0.0.1:5000
@userId = paste_created_user_id_here
@otherUserId = paste_another_user_id_here
@token = paste_jwt_token_here
@otherToken = paste_another_user_jwt_here
@conversationId = paste_conversation_id_here

### Health check
GET {{baseUrl}}/api/health

### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Noa Cohen",
  "email": "noa@example.com",
  "password": "SecurePass123!",
  "bio": "Looking for a relaxed food and beach trip.",
  "age": 24,
  "location": "Tel Aviv",
  "interests": ["food", "beaches", "music"],
  "preferredDestinations": ["Greece", "Italy"],
  "travelStyle": "Backpacking"
}

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "noa@example.com",
  "password": "SecurePass123!"
}

### Current authenticated user
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### Current user without a token - expected 401
GET {{baseUrl}}/api/auth/me

### Current user with an invalid token - expected 401
GET {{baseUrl}}/api/auth/me
Authorization: Bearer invalid-token

### Update the authenticated user's profile
PUT {{baseUrl}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "bio": "Updated TripMatch profile bio.",
  "travelStyle": "City breaks"
}

