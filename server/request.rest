### Read the persisted questionnaire answers after a refresh - expected 200
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### Attempt to update another user through the disabled legacy route - expected 403
PUT {{baseUrl}}/api/users/{{otherUserId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "bio": "This update must be rejected."
}

### Attempt to delete another user through the disabled legacy route - expected 403
DELETE {{baseUrl}}/api/users/{{otherUserId}}
Authorization: Bearer {{token}}

### Invalid profile field - expected 400 from JOI
PUT {{baseUrl}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "password": "ThisFieldIsNotAllowed123!"
}

### Get all users
GET {{baseUrl}}/api/users
Authorization: Bearer {{token}}

### Get users by location
GET {{baseUrl}}/api/users?location=Tel%20Aviv
Authorization: Bearer {{token}}

### Get users by travel style
GET {{baseUrl}}/api/users?travelStyle=Backpacking
Authorization: Bearer {{token}}

### Get user by id
GET {{baseUrl}}/api/users/{{userId}}
Authorization: Bearer {{token}}

### Duplicate registration - expected 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Noa Cohen",
  "email": "noa@example.com",
  "password": "SecurePass123!"
}

### Login for a legacy user without a password - expected 401, not 500
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "legacy-without-password@example.com",
  "password": "ExamplePassword123!"
}

### Upload file
POST {{baseUrl}}/api/file
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=TripMatchBoundary

--TripMatchBoundary
Content-Disposition: form-data; name="file"; filename="sample-photo.jpg"
Content-Type: image/jpeg

< ./sample-photo.jpg
--TripMatchBoundary--

### Record a like for another user
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "toUser": "{{otherUserId}}",
  "action": "like"
}

### List the authenticated user's swipes
GET {{baseUrl}}/api/swipes
Authorization: Bearer {{token}}

### Create the reciprocal like as the other user (creates one match)
POST {{baseUrl}}/api/swipes
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{
  "toUser": "{{userId}}",
  "action": "like"
}

### List matches belonging to the authenticated user
GET {{baseUrl}}/api/matches
Authorization: Bearer {{token}}

### List conversations belonging to the authenticated user
GET {{baseUrl}}/api/conversations
Authorization: Bearer {{token}}

### Open or create the conversation for an existing match
GET {{baseUrl}}/api/conversations/with/{{otherUserId}}
Authorization: Bearer {{token}}

### Load a conversation and its messages
GET {{baseUrl}}/api/conversations/{{conversationId}}/messages
Authorization: Bearer {{token}}

### Send a message as the authenticated user
POST {{baseUrl}}/api/conversations/{{conversationId}}/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Hi! Want to compare travel plans?"
}

### Delete the authenticated user - expected 200 (run last)
DELETE {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}
