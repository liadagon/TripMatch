{
  "name": "tripmatch-server",
  "version": "1.0.0",
  "description": "TripMatch backend API",
  "main": "server.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "audit:registration-state": "node scripts/auditRegistrationState.js",
    "diagnose:returning-google": "node scripts/diagnoseReturningGoogleUser.js",
    "diagnose:authenticated-identity": "node scripts/diagnoseAuthenticatedIdentity.js",
    "cleanup:google-avatars": "node scripts/removeImportedGoogleAvatars.js",
    "setup:paypal-boost": "node scripts/setupPayPalBoostPlan.js",
    "verify:brevo-email": "node scripts/verifyBrevoEmail.js",
    "verify:email-otp": "node scripts/verifyEmailOtpFlow.js",
    "verify:gridfs-upload": "node scripts/verifyGridFsUpload.js",
    "verify:google-auth": "node scripts/verifyGoogleAuthFlow.js",
    "verify:onboarding": "node scripts/verifyOnboardingFlow.js",
    "verify:onboarding-mongo": "node scripts/verifyOnboardingMongo.js",
    "verify:registration-architecture": "node scripts/verifyRegistrationArchitecture.js",
    "verify:registration-mongo": "node scripts/verifyRegistrationMongo.js",
    "verify:profile-consistency-mongo": "node scripts/verifyProfileConsistencyMongo.js",
