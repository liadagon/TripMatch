          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Swipe is saved', () => pm.response.to.have.status(200));",
                  "pm.test('Swipe response succeeds', () => pm.expect(pm.response.json().success).to.eql(true));"
