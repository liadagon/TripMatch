{
  "info": {
    "_postman_id": "63bb6b8d-9f14-4df6-b84a-3408f16a2e08",
    "name": "TripMatch API",
    "description": "Safe final-project API demonstration using TripMatch's real Express routes. Run Auth first. Relationship folders require a fully onboarded disposable account and the IDs described in the selected environment template. Requests that mutate PayPal state or delete data are skipped unless their explicit safety variable is enabled.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Register and login with disposable credentials, exercise Google or email OTP authentication when manually configured, then prove Bearer access. Successful login, Google authentication, and OTP verification save token and userId.",
      "item": [
        {
          "name": "Register Disposable User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('email') || pm.environment.get('email') === 'tripmatch.postman@example.com') {",
                  "  pm.environment.set('email', `tripmatch.postman.${Date.now()}@example.com`);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration returns 201', () => pm.response.to.have.status(201));",
                  "pm.test('Registration returns JSON', () => pm.response.to.be.json);",
                  "const body = pm.response.json();",
                  "pm.test('Registration succeeds with user data', () => {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('object');",
                  "});",
                  "if (body.data?._id) pm.environment.set('userId', body.data._id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "CREATE evidence. No auth. Expected 201. Requires name, email, and password; the example.com placeholder is made unique before registration."
          }
        },
        {
          "name": "Login and Save JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Login returns JSON', () => pm.response.to.be.json);",
                  "const body = pm.response.json();",
                  "pm.test('JWT exists in the actual response shape', () => {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (body.token) pm.environment.set('token', body.token);",
                  "if (body.data?._id) pm.environment.set('userId', body.data._id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Authenticates the disposable account. No auth; expected 200. Requires email and password. The test saves response.token as token."
          }
        },
        {
          "name": "Get Authenticated Identity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Protected identity returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Authenticated user data exists', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('object');",
                  "  pm.expect(body.data._id).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Protected READ evidence. Bearer auth required; expected 200. Requires baseUrl and token."
          }
        },
        {
          "name": "Google Authentication and Save JWT (Manual Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Google authentication returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('TripMatch JWT is returned', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "if (body.token) pm.environment.set('token', body.token);",
                  "if (body.data?._id) pm.environment.set('userId', body.data._id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{firebaseIdToken}}\",\n  \"intent\": \"{{authIntent}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/google",
            "description": "Manual Firebase integration request. Obtain a fresh Firebase ID token through the real Google sign-in flow and place it in firebaseIdToken. Set authIntent to login for an existing TripMatch account or register for a disposable new account. Expected 200; saves the returned TripMatch JWT. Never store a real Firebase token in the exported environment."
          }
        },
        {
          "name": "Request Email OTP (Manual Email Delivery)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP request returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('OTP response is intentionally non-enumerating', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"intent\": \"{{authIntent}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/email/request-code",
            "description": "Requests a real six-digit email OTP. Requires configured email delivery, a disposable inbox, and authIntent set to login or register. Rate limits and a resend cooldown apply; run manually rather than repeatedly in a collection runner."
          }
        },
        {
          "name": "Verify Email OTP and Save JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP verification returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('TripMatch JWT is returned', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "if (body.token) pm.environment.set('token', body.token);",
                  "if (body.data?._id) pm.environment.set('userId', body.data._id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otpCode}}\",\n  \"intent\": \"{{authIntent}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/email/verify-code",
            "description": "Enter the fresh six-digit code delivered by Request Email OTP. email and authIntent must match the request. Expected 200; saves token and userId. OTPs expire and are single-use."
          }
        }
      ]
    },
