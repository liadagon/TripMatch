    {
      "name": "Files - GridFS",
      "description": "Upload an authenticated profile image to GridFS and retrieve it from the public app-owned file route. Upload requires a local JPEG, PNG, WebP, or GIF no larger than 5MB.",
      "item": [
        {
          "name": "Upload Profile Image to GridFS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Image upload returns 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('App-owned image URL is returned', () => pm.expect(body.url).to.be.a('string').and.not.empty);",
                  "if (body.url) {",
                  "  pm.environment.set('uploadedFileUrl', body.url);",
                  "  const fileId = body.url.split('/').filter(Boolean).pop();",
                  "  if (fileId) pm.environment.set('fileId', fileId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{uploadFilePath}}",
                  "description": "Select one disposable image file manually if your Postman version does not resolve uploadFilePath."
                }
              ]
            },
            "url": "{{baseUrl}}/api/file",
            "description": "Authenticated multipart upload. The only accepted field is file; supported MIME types are JPEG, PNG, WebP, and GIF, up to 5MB. Expected 201. The test saves uploadedFileUrl and the final path segment as fileId."
          }
        },
        {
          "name": "Retrieve GridFS Profile Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Image retrieval returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is an image', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image/'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "image/*"
              }
            ],
            "url": "{{baseUrl}}/api/file/{{fileId}}",
            "description": "Public GridFS retrieval for an existing app-owned fileId. Expected 200 with an image Content-Type. Run the upload first or provide a disposable existing fileId."
          }
        }
      ]
    },
