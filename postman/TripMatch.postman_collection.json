                  "pm.test('User detail exists', () => pm.expect(pm.response.json().data).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{otherUserId}}",
            "description": "Protected single-resource READ. Set otherUserId to a disposable user's real MongoDB ObjectId. Expected 200."
          }
        }
      ]
    },
    {
      "name": "Swipes",
