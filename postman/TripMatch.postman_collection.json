        {
          "name": "400 - Invalid Registration Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Validation failure returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validation failure is JSON', () => pm.response.to.be.json);",
                  "pm.test('Failure response is unsuccessful', () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
